#include <stdio.h>
#include <string.h>
#include <ctype.h>

char stack[100]; int top = -1;

int prec(char c) {
    if (c == '+' || c == '-') return 1;
    if (c == '*' || c == '/') return 2;
    if (c == '^') return 3;
    return 0;
}

void rev(char* s) {
    int len = strlen(s);
    for (int i = 0; i < len / 2; i++) {
        char t = s[i]; s[i] = s[len - 1 - i]; s[len - 1 - i] = t;
    }
}

void infixToPrefix(char* inf, char* pref) {
    int k = 0;
    rev(inf);
    for (int i = 0; inf[i]; i++) {
        if (inf[i] == ')') inf[i] = '(';
        else if (inf[i] == '(') inf[i] = ')';
    }

    for (int i = 0; inf[i]; i++) {
        if (isalnum(inf[i])) pref[k++] = inf[i];
        else if (inf[i] == '(') stack[++top] = inf[i];
        else if (inf[i] == ')') {
            while (top >= 0 && stack[top] != '(') pref[k++] = stack[top--];
            top--;
        } else if (inf[i] != ' ') {
            while (top >= 0 && prec(stack[top]) > prec(inf[i])) pref[k++] = stack[top--];
            stack[++top] = inf[i];
        }
    }
    while (top >= 0) pref[k++] = stack[top--];
    pref[k] = '\0';
    rev(pref);
}

int main() {
    char inf[100] = "A + B * C - (D / E)", pref[100];
    infixToPrefix(inf, pref);
    printf("Prefix: %s\n", pref);
    return 0;
}
