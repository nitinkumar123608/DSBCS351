#include <stdio.h>

int main() {
    int arr[100], n, i, value, pos, choice;

    printf("Enter size of array: ");
    scanf("%d", &n);

    printf("Enter elements:\n");
    for (i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    printf("\n1. Insert at beginning");
    printf("\n2. Insert at end");
    printf("\n3. Insert at given position");
    printf("\nEnter your choice: ");
    scanf("%d", &choice);

    printf("Enter value to insert: ");
    scanf("%d", &value);

    if (choice == 1) {
        // Insert at beginning
        for (i = n; i > 0; i--) {
            arr[i] = arr[i - 1];
        }
        arr[0] = value;
        n++;
    }

    else if (choice == 2) {
        // Insert at end
        arr[n] = value;
        n++;
    }

    else if (choice == 3) {
        // Insert at given position
        printf("Enter position: ");
        scanf("%d", &pos);

        if (pos < 1 || pos > n + 1) {
            printf("Invalid position\n");
            return 0;
        }

        // Shift elements to the right
        for (i = n; i >= pos; i--) {
            arr[i] = arr[i - 1];
        }

        arr[pos - 1] = value;
        n++;
    }

    else {
        printf("Invalid choice\n");
        return 0;
    }

    printf("\nArray after insertion:\n");
    for (i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }

    return 0;
}
