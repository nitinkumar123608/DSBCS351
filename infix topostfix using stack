#include <stdio.h>
#include <ctype.h>

char stack[100];
int top = -1;

int prec(char c) {
    if (c == '+' || c == '-') return 1;
    if (c == '*' || c == '/') return 2;
    if (c == '^') return 3;
    return 0;
}

void infixToPostfix(char* exp) {
    for (int i = 0; exp[i]; i++) {
        if (isalnum(exp[i])) printf("%c", exp[i]);
        else if (exp[i] == '(') stack[++top] = exp[i];
        else if (exp[i] == ')') {
            while (top >= 0 && stack[top] != '(') printf("%c", stack[top--]);
            top--; // pop '('
        } else if (exp[i] != ' ') { // Operator
            while (top >= 0 && prec(stack[top]) >= prec(exp[i])) printf("%c", stack[top--]);
            stack[++top] = exp[i];
        }
    }
    while (top >= 0) printf("%c", stack[top--]);
    printf("\n");
}

int main() {
    infixToPostfix("A + B * C - (D / E)");
    return 0;
}
